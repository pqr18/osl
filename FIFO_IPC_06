#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <ctype.h>

int main()
{
    int fd1, fd2;
    char buffer[200];
    char result[500];

    int chars = 0, words = 0, lines = 0;
    int inWord = 0;
    int n;

    // Open first FIFO for reading
    fd1 = open("fifo1", O_RDONLY);

    // Read sentences from Process 1
    while ((n = read(fd1, buffer, sizeof(buffer))) > 0)
    {
        for (int i = 0; i < n; i++)
        {
            chars++;

            if (buffer[i] == '\n')
                lines++;

            if (isspace((unsigned char)buffer[i]))
                inWord = 0;
            else if (inWord == 0)
            {
                words++;
                inWord = 1;
            }
        }
    }

    close(fd1);

    // Create output file and write result
    FILE *fp = fopen("output.txt", "w");

    fprintf(fp, "Number of Characters = %d\n", chars);
    fprintf(fp, "Number of Words = %d\n", words);
    fprintf(fp, "Number of Lines = %d\n", lines);

    fclose(fp);

    // Read result from the file
    fp = fopen("output.txt", "r");

    int k = fread(result, 1, sizeof(result) - 1, fp);
    result[k] = '\0';

    fclose(fp);

    // Open second FIFO for writing
    fd2 = open("fifo2", O_WRONLY);

    // Send file contents to Process 1
    write(fd2, result, strlen(result));

    close(fd2);

    return 0;
}
