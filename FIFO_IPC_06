#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

int main()
{
    int fd1, fd2;
    char str[200];
    char result[500];

    // Create two FIFOs
    unlink("fifo1");
    unlink("fifo2");

    mkfifo("fifo1", 0666);
    mkfifo("fifo2", 0666);

    printf("Enter sentences (type END to stop):\n");

    // Open first FIFO for writing
    fd1 = open("fifo1", O_WRONLY);

    // Accept and send sentences
    while (1)
    {
        fgets(str, sizeof(str), stdin);

        if (strncmp(str, "END", 3) == 0)
            break;

        write(fd1, str, strlen(str));
    }

    close(fd1);

    // Open second FIFO for reading
    fd2 = open("fifo2", O_RDONLY);

    // Read result from Process 2
    int n = read(fd2, result, sizeof(result) - 1);

    if (n > 0)
    {
        result[n] = '\0';
        printf("\nResult received from Process 2:\n");
        printf("%s", result);
    }

    close(fd2);

    // Remove FIFO files
    unlink("fifo1");
    unlink("fifo2");

    return 0;
}


