//Practical 7: Pipes

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>
#include <fcntl.h>

int main()
{
    int p1[2], p2[2];
    pid_t pid;
    char filename[100];
    char buffer[1024];
    int n, fd;

    // Create two pipes
    pipe(p1);
    pipe(p2);

    // Create child process
    pid = fork();

    if (pid > 0)
    {
        // Parent process

        close(p1[0]);
        close(p2[1]);

        printf("Enter file name: ");
        scanf("%99s", filename);

        // Send filename to child
        write(p1[1], filename, strlen(filename) + 1);

        close(p1[1]);

        // Read file contents from child
        printf("\nFile contents:\n");

        while ((n = read(p2[0], buffer, sizeof(buffer))) > 0)
        {
            write(1, buffer, n);
        }

        close(p2[0]);

        wait(NULL);
    }
    else if (pid == 0)
    {
        // Child process

        close(p1[1]);
        close(p2[0]);

        // Read filename from parent
        read(p1[0], filename, sizeof(filename));

        close(p1[0]);

        // Open the file
        fd = open(filename, O_RDONLY);

        if (fd < 0)
        {
            perror("File opening failed");
            close(p2[1]);
            exit(1);
        }

        // Read file and send contents to parent
        while ((n = read(fd, buffer, sizeof(buffer))) > 0)
        {
            write(p2[1], buffer, n);
        }

        close(fd);
        close(p2[1]);

        exit(0);
    }
    else
    {
        perror("Fork failed");
        exit(1);
    }

    return 0;
}
