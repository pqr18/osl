//Practical no. 2 : Process Management 

#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main()
{
    int a[20], n, i, j, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    pid_t pid = fork();

    if(pid < 0)
    {
        printf("Fork failed!");
    }

    else if(pid == 0)
    {
        // Child process
        printf("\nChild Process\n");
        printf("Child PID: %d\n", getpid());

        printf("Elements received by child: ");
        for(i = 0; i < n; i++)
        {
            printf("%d ", a[i]);
        }

        printf("\nChild process completed.\n");
        exit(0);
    }

    else
    {
        // Parent process
        printf("\nParent Process\n");
        printf("Parent PID: %d\n", getpid());

        // Sorting using Bubble Sort
        for(i = 0; i < n - 1; i++)
        {
            for(j = 0; j < n - i - 1; j++)
            {
                if(a[j] > a[j + 1])
                {
                    temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                }
            }
        }

        printf("Sorted elements: ");
        for(i = 0; i < n; i++)
        {
            printf("%d ", a[i]);
        }

        wait(NULL);

        printf("\nParent process: Child has completed.\n");
    }

    return 0;
}
