//Practical no. 2 : Process Management 
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main()
{
    int a[20], n, i, j, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    // Creating Child Process
    pid_t pid = fork();

    if(pid < 0)
    {
        printf("Fork failed!\n");
        exit(1);
    }

    // CHILD PROCESS
    else if(pid == 0)
    {
        printf("\n--- CHILD PROCESS ---\n");
        printf("Child PID: %d\n", getpid());

        // Child sorts the array
        for(i = 0; i < n - 1; i++)
        {
            for(j = 0; j < n - i - 1; j++)
            {
                if(a[j] > a[j + 1])
                {
                    temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                }
            }
        }

        printf("Child Sorted Elements: ");
        for(i = 0; i < n; i++)
        {
            printf("%d ", a[i]);
        }

        printf("\nChild Process Completed.\n");
        exit(0);
    }

    // PARENT PROCESS
    else
    {
        printf("\n--- PARENT PROCESS ---\n");
        printf("Parent PID: %d\n", getpid());

        // Parent sorts the array
        for(i = 0; i < n - 1; i++)
        {
            for(j = 0; j < n - i - 1; j++)
            {
                if(a[j] > a[j + 1])
                {
                    temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                }
            }
        }

        printf("Parent Sorted Elements: ");
        for(i = 0; i < n; i++)
        {
            printf("%d ", a[i]);
        }

        // Parent waits for child
        wait(NULL);

        printf("\nParent: Child process has completed.\n");
    }

    return 0;
}
